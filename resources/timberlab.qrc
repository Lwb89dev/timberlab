<RCC>
    <qresource prefix="/qt/qml/TimberLab">
        <file alias="qmldir">../qml/qmldir</file>
        <file alias="Theme.qml">../qml/Theme.qml</file>
    </qresource>
    <qresource prefix="/qml">
        <file alias="Main.qml">../qml/Main.qml</file>
        <file alias="PartsPanel.qml">../qml/PartsPanel.qml</file>
        <file alias="Inspector.qml">../qml/Inspector.qml</file>
        <file alias="JointSection.qml">../qml/JointSection.qml</file>
    </qresource>
    <qresource prefix="/data">
        <file alias="materials.json">data/materials.json</file>
        <file alias="presets.json">data/presets.json</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="icon.png">../assets/icons/icon.png</file>
    </qresource>
</RCC>
